{
  "name": "keenpix",
  "version": "0.1.8",
  "description": "Open-source, self-hosted image optimization with a drop-in transform API, sharp, Postgres, disk caching, and analytics.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/lord007tn/keenpix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lord007tn/keenpix.git"
  },
  "bugs": {
    "url": "https://github.com/lord007tn/keenpix/issues"
  },
  "keywords": [
    "image-optimization",
    "image-cdn",
    "self-hosted",
    "sharp",
    "postgres",
    "tanstack-start",
    "open-source"
  ],
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "build:selfhost": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "smoke": "playwright test",
    "lint": "biome check",
    "check": "biome check",
    "format": "biome format --write",
    "fix": "biome check --write",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "knip": "knip",
    "doctor": "react-doctor --full --no-score --fail-on none",
    "health": "pnpm lint && pnpm run typecheck && pnpm test && pnpm run knip && pnpm run doctor && pnpm build",
    "toolchain": "pnpm run health",
    "release:notes": "pnpm dlx changelogithub@14.0.0",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:backfill-cuid": "tsx prisma/backfill-rollup-cuid.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "unrs-resolver",
      "sharp"
    ],
    "overrides": {
      "@hono/node-server": "^1.19.14"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@better-auth/api-key": "1.6.11",
    "@fontsource-variable/inter": "^5.2.8",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.2.1",
    "@takumi-rs/image-response": "^1.6.0",
    "@tanstack/pacer": "^0.21.1",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-form": "1.32.0",
    "@tanstack/react-form-devtools": "0.2.27",
    "@tanstack/react-pacer-devtools": "0.7.1",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "5.100.14",
    "@tanstack/react-router": "^1.167.4",
    "@tanstack/react-router-devtools": "^1.166.9",
    "@tanstack/react-start": "^1.166.15",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-table-devtools": "8.21.3",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cuid": "^3.0.0",
    "dayjs": "^1.11.20",
    "fumadocs-core": "16.9.3",
    "fumadocs-mdx": "15.0.10",
    "fumadocs-ui": "16.9.3",
    "got": "^15.0.5",
    "lru-cache": "^11.5.1",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "nitro": "latest",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "prisma": "^7.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "3.8.0",
    "shadcn": "^4.8.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "svgo": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.60.0",
    "@tanstack/devtools-vite": "^0.6.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.19.15",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.2",
    "jsdom": "^27.4.0",
    "knip": "^6.15.0",
    "react-doctor": "^0.2.14",
    "typescript": "^5.9.3",
    "ultracite": "^7.7.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "web-vitals": "^5.1.0"
  }
}
