{
  "name": "@keenpix/root",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "turbo watch dev --filter @keenpix/app",
    "dev:worker": "turbo watch dev --filter @keenpix/worker",
    "dev:transform": "turbo watch dev --filter @keenpix/transform-app",
    "dev:docs": "turbo watch dev --filter @keenpix/docs",
    "dev:all": "turbo watch dev --filter @keenpix/app --filter @keenpix/transform-app --filter @keenpix/worker --filter @keenpix/docs",
    "build": "turbo run build",
    "build:app": "turbo run build --filter @keenpix/app...",
    "build:runtime": "turbo run build --filter @keenpix/app... --filter @keenpix/transform-app... --filter @keenpix/worker... --filter @keenpix/docs...",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check",
    "check": "ultracite check --max-diagnostics=200",
    "format": "biome format --write .",
    "fix": "ultracite fix --max-diagnostics=200",
    "knip": "knip",
    "doctor": "react-doctor apps/app --full --no-dead-code --no-score --fail-on error",
    "health": "pnpm lint && pnpm typecheck && pnpm test && pnpm knip && pnpm run doctor && pnpm build",
    "toolchain": "pnpm health",
    "db:generate": "pnpm --filter @keenpix/database generate",
    "db:migrate": "pnpm --filter @keenpix/database migrate",
    "db:push": "pnpm --filter @keenpix/database push",
    "db:seed": "pnpm --filter @keenpix/database seed",
    "db:reset": "pnpm --filter @keenpix/database reset",
    "release:notes": "pnpm dlx changelogithub@14.0.0",
    "release:packages": "changeset publish",
    "changeset": "changeset",
    "seo:drift": "pnpm --filter @keenpix/app seo:drift",
    "brand:export": "pnpm --filter @keenpix/app brand:export",
    "db:backfill-cuid": "pnpm --filter @keenpix/app db:backfill-cuid",
    "db:backfill-project-edge": "pnpm --filter @keenpix/app db:backfill-project-edge",
    "billing:configure-benefits": "pnpm --filter @keenpix/app billing:configure-benefits",
    "billing:configure-catalog": "pnpm --filter @keenpix/app billing:configure-catalog"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "unrs-resolver",
      "sharp"
    ],
    "overrides": {
      "@hono/node-server": "^1.19.14"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^22.19.15",
    "knip": "^6.15.0",
    "react-doctor": "^0.2.14",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3",
    "ultracite": "^7.7.0",
    "vitest": "^3.2.4"
  }
}
