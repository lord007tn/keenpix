# Copy to .env and fill in.
POSTGRES_PASSWORD="change-me-for-a-real-deploy"
DATABASE_URL="postgresql://postgres:change-me-for-a-real-deploy@localhost:5432/keenpix"

# REQUIRED in production. Generate a real one with: openssl rand -hex 32
# The placeholder below is intentionally rejected at boot — replace it.
BETTER_AUTH_SECRET="REPLACE_ME-run-openssl-rand-hex-32"
BETTER_AUTH_URL="http://localhost:3000"
# Only needed for local/source builds. The published Docker image falls back to
# the browser origin for client-side auth URLs.
VITE_KEENPIX_PUBLIC_URL="http://localhost:3000"
KEENPIX_APP_URL="http://localhost:3000"
# Optional Docker Compose overrides.
# KEENPIX_PORT="3000"
# KEENPIX_IMAGE="ghcr.io/lord007tn/keenpix:latest"
# Opt-in container resource caps (Docker Compose). Default 0 = no limit, so the
# stack runs unbounded until you set these. When set, Docker enforces the cap and
# the Operations page CPU/RAM gauges read it as the real ceiling. Accept Docker
# size suffixes (e.g. 2g, 1.5). Recommended starting point: app 2 CPU / 2 GB,
# postgres 1 CPU / 1 GB. Caveat: too low a memory cap can get a container OOM-killed.
# KEENPIX_MEM_LIMIT="2g"
# KEENPIX_MEM_RESERVATION="1g"
# KEENPIX_CPU_LIMIT="2"
# KEENPIX_PG_MEM_LIMIT="1g"
# KEENPIX_PG_MEM_RESERVATION="512m"
# KEENPIX_PG_CPU_LIMIT="1"
# Docker entrypoint controls. Leave enabled for normal self-host installs.
# KEENPIX_RUN_MIGRATIONS="true"
# KEENPIX_RUN_SEED="true"
# Super admin bootstrap. Legacy KEENPIX_ADMIN_* names are still accepted as aliases.
KEENPIX_SUPER_ADMIN_EMAIL="admin@example.com"
KEENPIX_SUPER_ADMIN_PASSWORD="change-me-before-running"
LOG_LEVEL="info"

# Optional SMTP defaults. These are used when database-managed SMTP settings
# are not enabled from Settings -> Email.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="smtp-user"
# SMTP_PASSWORD="smtp-password"
# SMTP_FROM_EMAIL="keenpix@example.com"
# SMTP_FROM_NAME="Keenpix"

# Optional Cloudflare edge analytics. Used when database-managed Cloudflare
# settings are not enabled from Settings -> CDN cache. The token only needs the
# zone-scoped Analytics -> Read permission. Lets the analytics page show real
# Cloudflare edge cache hit-rate next to the keenpix origin-shield figures.
# CLOUDFLARE_API_TOKEN="cf-zone-analytics-read-token"
# CLOUDFLARE_ZONE_ID="0123456789abcdef0123456789abcdef"
# CLOUDFLARE_HOST="images.example.com"

# ── Deployment mode ──────────────────────────────────────────
# Set to "true" on a self-hosted instance to disable the public marketing home:
# / shows a minimal dashboard splash, /docs stays available with noindex metadata,
# and /llms.txt plus the public sitemap return 404. docker-compose sets this automatically.
# KEENPIX_SELF_HOST="true"

# ── Image cache ──────────────────────────────────────────────
KEENPIX_CACHE_DIR="./.keenpix-cache"
# Disk cache cap before LRU eviction (bytes). 8 GB is a good CDN-origin-shield
# starting point; lower it for small disks.
# KEENPIX_CACHE_MAX_BYTES="8589934592"
# Serve cached variants immediately after this age and refresh them in the background.
# Set 0 to disable stale refresh. Default 24 hours.
# KEENPIX_CACHE_STALE_MS="86400000"
# In-process hot variant LRU cap (bytes). Set 0 to disable.
# KEENPIX_MEMORY_CACHE_MAX_BYTES="268435456"

# ── Transform limits (DoS guards) ────────────────────────────
# Max bytes fetched from an origin before 413. Default 50 MB.
# KEENPIX_MAX_ORIGIN_BYTES="52428800"
# Decode-time input pixel ceiling (decompression-bomb guard). Default ~50 MP.
# KEENPIX_MAX_INPUT_PIXELS="50000000"
# Longest output side when a request gives no w/h (bounds full-res re-encodes). Default 4096.
# KEENPIX_MAX_DIMENSION="4096"
# Per-attempt origin fetch timeout in ms; a slow origin returns 504. Default 10000.
# KEENPIX_ORIGIN_TIMEOUT_MS="10000"
# Max concurrent fetch+transform jobs; excess past the queue sheds 503.
# Default: number of CPU cores (minimum 2). The value below is just an example.
# KEENPIX_MAX_CONCURRENCY="4"
# KEENPIX_MAX_QUEUE="100"
