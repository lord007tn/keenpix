# Copy to .env and fill in.
POSTGRES_PASSWORD="change-me-for-a-real-deploy"
DATABASE_URL="postgresql://postgres:change-me-for-a-real-deploy@localhost:5432/keenpix"

# REQUIRED in production. Generate a real one with: openssl rand -hex 32
# The placeholder below is intentionally rejected at boot — replace it.
BETTER_AUTH_SECRET="REPLACE_ME-run-openssl-rand-hex-32"
BETTER_AUTH_URL="http://localhost:3000"
# Cloud Google sign-in. Create a Web OAuth client with
# https://keenpix.com/api/auth/callback/google as its redirect URI. Keep the
# client secret in the deployment secret store; never expose it as VITE_*.
# GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."
# Public GTM container ID. The container loads only after analytics consent.
# VITE_GTM_CONTAINER_ID="GTM-XXXXXXX"
# Preferred direct GA4 measurement ID. When set, this takes precedence over GTM
# and loads the Google tag only after the same explicit analytics consent.
# VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# Only needed for local/source builds. The published Docker image falls back to
# the browser origin for client-side auth URLs.
VITE_KEENPIX_PUBLIC_URL="http://localhost:3000"
KEENPIX_APP_URL="http://localhost:3000"
# Optional Docker Compose overrides.
# KEENPIX_PORT="3000"
# KEENPIX_IMAGE="ghcr.io/lord007tn/keenpix:latest"
# Opt-in container resource caps (Docker Compose). Default 0 = no limit, so the
# stack runs unbounded until you set these. When set, Docker enforces the cap and
# the Operations page CPU/RAM gauges read it as the real ceiling. Accept Docker
# size suffixes (e.g. 2g, 1.5). Recommended starting point: app 2 CPU / 2 GB,
# postgres 1 CPU / 1 GB. Caveat: too low a memory cap can get a container OOM-killed.
# KEENPIX_MEM_LIMIT="2g"
# KEENPIX_MEM_RESERVATION="1g"
# KEENPIX_CPU_LIMIT="2"
# KEENPIX_PG_MEM_LIMIT="1g"
# KEENPIX_PG_MEM_RESERVATION="512m"
# KEENPIX_PG_CPU_LIMIT="1"
# Docker entrypoint controls. Leave enabled for normal self-host installs.
# KEENPIX_RUN_MIGRATIONS="true"
# KEENPIX_RUN_SEED="true"
# Super admin bootstrap. Legacy KEENPIX_ADMIN_* names are still accepted as aliases.
KEENPIX_SUPER_ADMIN_EMAIL="admin@example.com"
KEENPIX_SUPER_ADMIN_PASSWORD="change-me-before-running"
LOG_LEVEL="info"
# Evlog writes structured logs to stdout by default. Optionally set a directory
# on a persistent volume to also retain rotating NDJSON files.
# KEENPIX_LOG_DIR="/app/data/logs"

# Transactional email is configured in the "Transactional email" section below
# (EMAIL_PROVIDER + provider vars). There is no in-app SMTP settings screen.

# Optional Cloudflare edge analytics. Surfaces real edge cache hit-rate next to
# the keenpix origin-shield figures (analytics page + admin Settings). Create a
# dedicated API token at Cloudflare -> My Profile -> API Tokens -> Create Token
# with Zone -> Analytics -> Read and Account -> Analytics -> Read. The account
# permission reads the per-project Analytics Engine events written by the edge
# Worker. Do NOT use a wrangler OAuth token in production (it expires).
# CLOUDFLARE_HOST optionally filters the zone-wide reconciliation dataset.
# For edge caching to actually happen, add a Cloudflare Cache Rule that caches
# /img/* (see content/docs/self-hosting/cdn.mdx).
# CLOUDFLARE_API_TOKEN="cf-zone-analytics-read-token"
# CLOUDFLARE_ACCOUNT_API_TOKEN="cf-account-analytics-read-token"
# CLOUDFLARE_ACCOUNT_ID="0123456789abcdef0123456789abcdef"
# CLOUDFLARE_ZONE_ID="0123456789abcdef0123456789abcdef"
# CLOUDFLARE_HOST="images.example.com"

# Cloudflare for SaaS custom delivery domains (managed cloud). The API token
# needs Zone / SSL and Certificates / Edit and Zone / Workers Routes / Edit.
# Deploy apps/custom-domain-edge, set its EDGE_SECRET to the same random
# value below, and configure an originless fallback origin before enabling this.
# The API installs one exact Worker route per customer hostname so Coolify only
# needs the canonical Keenpix hostname. All four non-default values are required.
# CLOUDFLARE_SAAS_API_TOKEN="cf-saas-provisioning-token"
# CLOUDFLARE_SAAS_ZONE_ID="0123456789abcdef0123456789abcdef"
# CLOUDFLARE_SAAS_CNAME_TARGET="customers.example.com"
# CLOUDFLARE_SAAS_WORKER_SCRIPT="keenpix-custom-domain-edge"
# CLOUDFLARE_SAAS_EDGE_SECRET="generate-at-least-32-random-characters"

# ── Deployment mode ──────────────────────────────────────────
# KEENPIX_MODE is the ONLY deployment switch. Leave it unset (or "selfhost") for a
# single-tenant self-hosted instance: no public marketing home (/ shows a minimal
# splash, /docs stays available with noindex, /llms.txt + sitemap 404), no billing,
# no self-signup. Set "cloud" for the multi-tenant hosted product (see cloud vars
# below). There is no separate KEENPIX_SELF_HOST flag — self-host is just "not cloud".
# KEENPIX_MODE="selfhost"

# ── Image cache ──────────────────────────────────────────────
KEENPIX_CACHE_DIR="./.keenpix-cache"
# Disk cache cap before LRU eviction (bytes). 8 GB is a good CDN-origin-shield
# starting point; lower it for small disks.
# KEENPIX_CACHE_MAX_BYTES="8589934592"
# Serve cached variants immediately after this age and refresh them in the background.
# Set 0 to disable stale refresh. Default 24 hours.
# KEENPIX_CACHE_STALE_MS="86400000"
# In-process hot variant LRU cap (bytes). Set 0 to disable.
# KEENPIX_MEMORY_CACHE_MAX_BYTES="268435456"
# Cache-Control header emitted on transform responses. Long-lived + immutable by
# default so an outer CDN can cache transform output; tune edge/browser TTLs here.
# KEENPIX_CACHE_CONTROL="public, max-age=31536000, immutable"

# ── Transform limits (DoS guards) ────────────────────────────
# Max bytes fetched from an origin before 413. Default 50 MB.
# KEENPIX_MAX_ORIGIN_BYTES="52428800"
# Decode-time input pixel ceiling (decompression-bomb guard). Default ~50 MP.
# KEENPIX_MAX_INPUT_PIXELS="50000000"
# Longest output side when a request gives no w/h (bounds full-res re-encodes). Default 4096.
# KEENPIX_MAX_DIMENSION="4096"
# Per-attempt origin fetch timeout in ms; a slow origin returns 504. Default 10000.
# KEENPIX_ORIGIN_TIMEOUT_MS="10000"
# Durable SDK prewarm jobs use BullMQ backed by Dragonfly (or Redis). Docker
# Compose supplies KEENPIX_QUEUE_URL. Source-only development defaults to local
# port 6379. The worker secret authenticates its calls back to the app.
KEENPIX_WORKER_SECRET="REPLACE_ME-run-openssl-rand-hex-32"
# KEENPIX_QUEUE_URL="redis://127.0.0.1:6379"
# Optional basic auth for the internal worker dashboard at /workbench. Coolify
# generates both when omitted; set both only when you want custom credentials.
# KEENPIX_WORKBENCH_USERNAME="keenpix-operator"
# KEENPIX_WORKBENCH_PASSWORD="generate-a-long-random-password"
# KEENPIX_WORKER_CONCURRENCY="4"
# KEENPIX_WORKER_PORT="3001"

# ══════════════════════════════════════════════════════════════
# CLOUD MODE (keenpix.com managed SaaS) — leave all of this unset
# for self-host. Set KEENPIX_MODE=cloud to enable multi-tenant
# self-signup, billing, quotas, and the shared/advanced tiers.
# See docker-compose.cloud.yml.
# ══════════════════════════════════════════════════════════════
# KEENPIX_MODE="cloud"

# ── Billing (Polar) ──────────────────────────────────────────
# Organization access token + server. Use the production Polar org for launch.
# POLAR_TOKEN="polar_oat_..."
# POLAR_SERVER="production"            # or "sandbox" while testing
# Where Polar returns the customer after checkout (defaults to the in-app billing
# settings page).
# POLAR_SUCCESS_URL="/app/settings?section=billing"
# Webhook signing secret from the Polar webhook endpoint pointed at
# https://keenpix.com/api/auth/polar/webhooks (events: subscription.created/
# active/updated/canceled/uncanceled/revoked). Without it, subscriptions never sync.
# POLAR_WEBHOOK_SECRET="whsec_..."
# Separate secret issued by the Polar sandbox endpoint configured at
# https://keenpix.com/api/auth/polar/sandbox-webhooks. This callback verifies and
# acknowledges sandbox delivery only; it never mutates production entitlements.
# POLAR_SANDBOX_WEBHOOK_SECRET="whsec_..."

# ── ClickHouse (advanced analytics + full-history logs) ──────
# Unset = analytics/logs stay on Postgres. Run apps/app/scripts/backfill-clickhouse.ts
# once after enabling to seed history.
# CLICKHOUSE_URL="http://clickhouse:8123"
# CLICKHOUSE_DATABASE="keenpix"
# CLICKHOUSE_USER="default"
# CLICKHOUSE_PASSWORD="change-me"

# ── Shared object-storage cache (Cloudflare R2, else maxio) ──
# Prefer R2 in production (free egress): set the endpoint/keys to your R2 bucket
# and drop the maxio service. maxio (region=auto, like R2) is the self-hosted
# fallback. Only active when KEENPIX_MODE=cloud AND all five are set.
# KEENPIX_CACHE_S3_BUCKET="keenpix-cache"
# KEENPIX_CACHE_S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# KEENPIX_CACHE_S3_REGION="auto"
# KEENPIX_CACHE_S3_ACCESS_KEY_ID="<r2 access key id>"
# KEENPIX_CACHE_S3_SECRET_ACCESS_KEY="<r2 secret access key>"

# ── Transactional email ──────────────────────────────────────
# Verification, password reset, and teammate invitations go through exactly ONE
# provider, chosen by EMAIL_PROVIDER. Leave EMAIL_PROVIDER unset to disable email.
# Fill in ONLY the block for the provider you select; the from-domain must be a
# verified sender for that provider. The app fails to start if the selected
# provider's required vars are missing.
# EMAIL_PROVIDER="postmark"   # postmark | resend | smtp

# postmark:
# POSTMARK_API_KEY="<postmark server token>"
# POSTMARK_FROM="Keenpix <no-reply@keenpix.com>"
# POSTMARK_MESSAGE_STREAM="outbound"

# resend:
# RESEND_API_KEY="<resend api key>"
# RESEND_FROM="Keenpix <no-reply@keenpix.com>"

# smtp (any SMTP relay, including self-hosted Mailpit/Postfix):
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="smtp-user"
# SMTP_PASSWORD="smtp-password"
# SMTP_FROM_EMAIL="keenpix@example.com"
# SMTP_FROM_NAME="Keenpix"

# ── Usage-metering cron ──────────────────────────────────────
# Shared secret the hourly job sends as `Authorization: Bearer $CRON_SECRET`
# when POSTing /api/internal/billing/report-usage (reports delivered GB to Polar).
# CRON_SECRET="<random secret>"
