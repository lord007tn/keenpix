{
  "name": "@keenpix/angular",
  "version": "0.2.0",
  "description": "Keenpix image loader for Angular NgOptimizedImage.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "publint": "publint",
    "pack:check": "pnpm run build && pnpm run publint && pnpm pack --dry-run",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run pack:check",
    "clean": "git clean -xdf dist node_modules"
  },
  "dependencies": {
    "@keenpix/core": "workspace:^"
  },
  "peerDependencies": {
    "@angular/common": ">=16",
    "@angular/core": ">=16"
  },
  "devDependencies": {
    "@angular/common": "~22.0.8",
    "@angular/compiler": "~22.0.8",
    "@angular/core": "~22.0.8",
    "publint": "^0.3.15",
    "rxjs": "^7.8.2",
    "tsdown": "0.22.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
