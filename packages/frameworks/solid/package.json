{
  "name": "@keenpix/solid",
  "version": "0.3.1",
  "description": "Responsive Keenpix image props for SolidJS.",
  "keywords": [
    "keenpix",
    "image",
    "solidjs",
    "responsive-images"
  ],
  "homepage": "https://keenpix.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lord007tn/keenpix.git",
    "directory": "packages/frameworks/solid"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "publint": "publint",
    "pack:check": "pnpm pack --dry-run"
  },
  "dependencies": {
    "@keenpix/core": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": ">=1"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "publint": "^0.3.15",
    "tsdown": "0.22.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
