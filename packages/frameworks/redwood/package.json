{
  "name": "@keenpix/redwood",
  "version": "0.1.0",
  "description": "Keenpix image primitives for RedwoodSDK and RedwoodJS.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@keenpix/core": "workspace:^"
  },
  "peerDependencies": {
    "@redwoodjs/web": ">=8"
  },
  "peerDependenciesMeta": {
    "@redwoodjs/web": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "0.22.3",
    "typescript": "^5.9.3"
  }
}
