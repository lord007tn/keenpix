{
  "name": "@keenpix/bullmq",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./connections": {
      "types": "./dist/connections.d.mts",
      "import": "./dist/connections.mjs"
    },
    "./jobs/*": {
      "types": "./dist/jobs/*.d.mts",
      "import": "./dist/jobs/*.mjs"
    },
    "./queues/*": {
      "types": "./dist/queues/*.d.mts",
      "import": "./dist/queues/*.mjs"
    },
    "./workers/*": {
      "types": "./dist/workers/*.d.mts",
      "import": "./dist/workers/*.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/connections.ts src/jobs/*.ts src/queues/*.ts src/workers/*.ts --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "git clean -xdf dist node_modules"
  },
  "dependencies": {
    "@keenpix/contracts": "workspace:*",
    "bullmq": "^6.0.7",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "tsdown": "0.22.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
