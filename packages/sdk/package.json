{
  "name": "@keenpix/sdk",
  "version": "0.1.0",
  "description": "Server-side SDK for Keenpix project, domain, configuration, and prewarm APIs.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./signing": {
      "types": "./dist/signing.d.mts",
      "import": "./dist/signing.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts src/signing.ts --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "publint": "publint",
    "clean": "git clean -xdf dist node_modules"
  },
  "dependencies": {
    "@keenpix/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "publint": "^0.3.15",
    "tsdown": "0.22.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
