{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [".env", ".env.*local"],
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^generate"],
      "outputs": ["dist/**", ".output/**", ".source/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "generate": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build", "^generate"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^generate"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
