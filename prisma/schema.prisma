// Prisma 7 client generator with the Postgres driver adapter configured in
// prisma.config.ts.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Keenpix domain models. Org-scoped so single-org self-hosting can grow into
// multi-org SaaS without reshaping request logs and projects.
model Org {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  projects  Project[]
}

model ApiKey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  prefix              String?
  key                 String
  referenceId         String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean   @default(true)
  rateLimitEnabled    Boolean   @default(true)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int       @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  permissions         String?
  metadata            String?
  activities          ApiKeyActivity[]

  @@index([configId])
  @@index([key])
  @@index([referenceId])
  @@map("apikey")
}

model ApiKeyActivity {
  id        String   @id @default(cuid())
  apiKeyId  String
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  method    String
  path      String
  status    Int
  projectId String?
  scope     String
  latencyMs Float?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@index([createdAt])
}

model SmtpSettings {
  id        String   @id
  enabled   Boolean  @default(false)
  host      String?
  port      Int      @default(587)
  secure    Boolean  @default(false)
  username  String?
  password  String?
  fromEmail String?
  fromName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id             String       @id @default(cuid())
  orgId          String
  org            Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String
  origin         String
  allowedOrigins String[]
  color1         String       @default("#FF6B2C")
  color2         String       @default("#FFA76B")
  // Defaults applied when a transform request omits the matching query param.
  autoFormat     Boolean      @default(true)
  stripMetadata  Boolean      @default(true)
  defaultQuality Int          @default(75)
  // Optional per-project pipeline policy. maxWidth caps the requested width
  // (0/null = no cap); defaultFit/defaultDpr apply when the request omits them.
  maxWidth       Int?
  defaultFit     String       @default("cover")
  defaultDpr     Int          @default(1)
  createdAt      DateTime     @default(now())
  requestLogs    RequestLog[]

  @@index([orgId])
}

// Instance-wide operations configuration (one row). Null fields fall back to
// the KEENPIX_* environment defaults. Mirrors the SmtpSettings single-row
// pattern. Disk cache cap is hot-applied; the others take effect on restart.
model OperationsSettings {
  id                   String   @id @default("default")
  diskCacheMaxMb       Int?
  memoryCacheMaxMb     Int?
  transformConcurrency Int?
  maxQueueDepth        Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model RequestLog {
  id        String   @id @default(cuid())
  orgId     String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ts        DateTime @default(now())
  path      String
  width     Int?
  quality   Int?
  format    String
  status    Int
  cached    Boolean
  latencyMs Float
  bytesIn   Int
  bytesOut  Int
  region    String?
  country   String?
  sourceHost String?

  @@index([projectId, ts])
  @@index([orgId, ts])
  @@index([projectId, sourceHost])
}

// better-auth tables. Keep these names aligned with the auth adapter config.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  role          String    @default("user")
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@index([email])
}

model StaffInvitation {
  id          String    @id @default(cuid())
  email       String
  role        String    @default("staff")
  tokenHash   String    @unique
  status      String    @default("pending")
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([status, expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  impersonatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
