{
  "name": "@keenpix/app",
  "version": "0.3.0",
  "private": true,
  "description": "The Keenpix TanStack application, API, transform runtime, and background workflows.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "build:selfhost": "pnpm build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "brand:export": "node scripts/export-brand-assets.mjs",
    "test": "vitest run",
    "smoke": "playwright test",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "doctor": "react-doctor --full --no-score --fail-on none",
    "seo:drift": "node scripts/seo-drift.mjs",
    "db:backfill-cuid": "tsx ../../packages/database/prisma/backfill-rollup-cuid.ts",
    "db:backfill-project-edge": "tsx scripts/backfill-project-edge-from-zone.ts",
    "billing:configure-benefits": "node scripts/configure-polar-benefits.mjs",
    "billing:configure-catalog": "node scripts/configure-polar-catalog.mjs",
    "clean": "git clean -xdf .cache .turbo .output .source node_modules"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@better-auth/api-key": "1.6.11",
    "@clickhouse/client": "^1.16.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@keenpix/auth": "workspace:*",
    "@keenpix/clickhouse": "workspace:*",
    "@keenpix/core": "workspace:*",
    "@keenpix/database": "workspace:*",
    "@keenpix/docs": "workspace:*",
    "@polar-sh/better-auth": "^1.8.4",
    "@polar-sh/sdk": "^0.48.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.2.1",
    "@takumi-rs/image-response": "^1.6.0",
    "@tanstack/pacer": "^0.21.1",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-form": "1.32.0",
    "@tanstack/react-form-devtools": "0.2.27",
    "@tanstack/react-pacer-devtools": "0.7.1",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "5.100.14",
    "@tanstack/react-router": "^1.167.4",
    "@tanstack/react-router-devtools": "^1.166.9",
    "@tanstack/react-start": "^1.166.15",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-table-devtools": "8.21.3",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cuid": "^3.0.0",
    "dayjs": "^1.11.20",
    "fumadocs-core": "16.9.3",
    "fumadocs-mdx": "15.0.10",
    "fumadocs-ui": "16.9.3",
    "got": "^15.0.5",
    "lru-cache": "^11.5.1",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "nitro": "latest",
    "nodemailer": "^8.0.10",
    "pino": "^10.3.1",
    "pg": "^8.21.0",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.0",
    "recharts": "3.8.0",
    "shadcn": "^4.8.0",
    "sharp": "^0.34.5",
    "simple-icons": "^16.24.1",
    "sonner": "^2.0.7",
    "svgo": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tanstack/devtools-vite": "^0.6.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.19.15",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.2",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
