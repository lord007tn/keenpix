{
  "name": "@keenpix/worker",
  "version": "0.3.2",
  "private": true,
  "description": "Durable Keenpix background job worker.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown src/index.ts --platform node",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "git clean -xdf dist node_modules"
  },
  "dependencies": {
    "@getworkbench/hono": "0.9.1",
    "@hono/node-server": "^1.19.14",
    "@keenpix/bullmq": "workspace:*",
    "@keenpix/logger": "workspace:*",
    "dayjs": "^1.11.20",
    "hono": "^4.12.30",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "tsdown": "0.22.3",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
