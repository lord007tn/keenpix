{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "keenpix-delivery-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "workers_dev": false,
  "secrets": { "required": ["EDGE_SECRET"] },
  // The zone route table is managed as one unit through the Cloudflare dashboard
  // or API. Do not declare only the wildcard here and overwrite no-Worker routes.
  "vars": {
    "FIRST_PARTY_HOSTNAME": "cdn.keenpix.com",
    "TRANSFORM_ORIGIN": "https://transform.keenpix.com"
  },
  "analytics_engine_datasets": [
    {
      "binding": "EDGE_ANALYTICS",
      "dataset": "keenpix_edge_requests"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
