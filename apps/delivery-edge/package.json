{
  "name": "@keenpix/delivery-edge",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "cf build",
    "dev": "cf dev",
    "upload": "cf workers versions create --prebuilt --mode production",
    "deploy": "cf workers deployments create --worker keenpix-custom-domain-edge --strategy percentage",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "cf workers types && tsc --noEmit",
    "clean": "git clean -xdf dist node_modules"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "cf": "1.0.0-beta.6",
    "typescript": "^5.9.3",
    "vite": "8.3.1",
    "vitest": "^3.2.4"
  }
}
